{
  "name": "tais-repository",
  "version": "1.6.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "integration-example"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "cd integration-example && npm run dev",
    "test": "node --test tests/*.test.js && tsx tests/e2e-hybrid-config.ts",
    "test:all": "npm test"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.992.0",
    "@aws-sdk/s3-request-presigner": "^3.992.0",
    "@octokit/rest": "^22.0.1"
  }
}
