# TAIS Registry — Production Environment Reference
#
# Consolidated 2026-09-18 (Relaunch Sprint 1, item I4) by grepping every
# `process.env.*` reference in packages/registry/src directly, rather than
# transcribing the four docs (DEPLOYMENT.md, PREFLIGHT.md, MONITORING.md,
# render.yaml) that had each drifted into their own partial list. If a var
# you need isn't here, it isn't read anywhere in this package's source as
# of this date — grep `process\.env\.` under packages/registry/src to
# re-verify rather than assuming this file is still complete.
#
# This is a reference for filling in real values in your deploy platform's
# own secret store (Render dashboard, Railway variables, etc.) — do not
# commit a real .env file. See DEPLOYMENT.md for how production actually
# deploys (Render, not the Railway/Vercel/AWS instructions also in that
# file) and PREFLIGHT.md for the `npm run preflight` checks that validate
# most of this at startup.

# =============================================================================
# CORE SERVER
# =============================================================================

NODE_ENV=production
PORT=10000
# error | warn | info | debug -- default: info
LOG_LEVEL=info
# Comma-separated. Only needed behind a reverse proxy / load balancer that
# isn't already trusted by default.
TRUSTED_PROXIES=

# =============================================================================
# DATABASE
# =============================================================================

# Required. Single-DB mode uses this alone.
DATABASE_URL=postgresql://user:password@host:5432/tais_registry
# Optional: set both of these to enable dual-database mode (RAG documents
# and skills/auth data on separate Postgres instances). Leave unset to
# fall back to DATABASE_URL for both -- see config/index.ts's
# effectiveRagUrl/effectiveSkillsUrl.
RAG_DATABASE_URL=
SKILLS_DATABASE_URL=

# =============================================================================
# AUTH & SECRETS
# =============================================================================

# Required, >= 32 characters -- AuthService rejects anything shorter, and
# the app throws at startup in production if this or CRON_SECRET is unset.
# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Prefix stamped on every generated API key. Default: tais_
API_KEY_PREFIX=tais_
# The message a wallet signs to prove ownership during login. Changing this
# in production invalidates every in-flight signature request.
AUTH_SIGNATURE_MESSAGE="TAIS Platform Authentication"

# REQUIRED IN PRACTICE, not just recommended: services/githubToken.ts
# falls back to a HARDCODED key ('tais-github-token-key-32-bytes-long!!',
# visible in this repo's own source) when this is unset, meaning stored
# GitHub tokens get encrypted with a key anyone with read access to this
# repo already has. No prior deployment doc or render.yaml ever
# provisioned this var. Generate with: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=

# Optional. Encrypts "community" (isPublic: true) RAG documents with a
# single server-held key instead of the fallback marker in
# services/communityCrypto.ts. Set a real value before relying on
# community RAG encryption in production.
RAG_COMMUNITY_ENCRYPTION_KEY=

# =============================================================================
# CORS & RATE LIMITING
# =============================================================================

# REQUIRED in production -- config/cors.ts throws at startup if this is
# unset or empty when NODE_ENV=production. Treated as a literal
# comma-separated allow-list, NOT a wildcard: a literal "*" rejects every
# real browser origin rather than allowing all of them.
CORS_ORIGIN=https://taisplatform.vercel.app
# Comma-separated wallet addresses allowed to hit /monitoring/*,
# /admin/*, and other admin-gated routes.
ADMIN_WALLET_ADDRESSES=
# Requests per window. Defaults shown are the code's own fallbacks.
RATE_LIMIT_STANDARD=100
RATE_LIMIT_STRICT=10
RATE_LIMIT_AUTH=5

# =============================================================================
# BLOCKCHAIN
# =============================================================================

# Default: https://cloudflare-eth.com (a public, rate-limited RPC -- fine
# for low volume, get a dedicated Alchemy/Infura key before relying on
# this at real traffic).
RPC_URL=https://cloudflare-eth.com
# Fallback address used for both Publisher and Auditor NFT checks if the
# two more specific vars below are unset. No prior render.yaml provisioned
# this at all.
GENESIS_CONTRACT=
PUBLISHER_NFT_ADDRESS=
AUDITOR_NFT_ADDRESS=
ENABLE_BLOCKCHAIN_VERIFICATION=false

# =============================================================================
# IPFS
# =============================================================================

# Leave false until real credentials are set below -- previously left
# true with no real project ID/secret, so every call silently errored
# (docs/E2E_TEST_REPORT.md's "IPFS: error" finding).
IPFS_ENABLED=false
IPFS_HOST=ipfs.infura.io
IPFS_PORT=5001
IPFS_PROTOCOL=https
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=

# =============================================================================
# RAG DOCUMENT STORAGE (S3-compatible, optional)
# =============================================================================

# 'database' stores RAG document blobs in Postgres directly (the default
# if unset). Set to anything else + the vars below to use S3-compatible
# object storage instead (services/ragStorage.ts).
RAG_STORAGE_PROVIDER=database
RAG_STORAGE_BUCKET=
RAG_STORAGE_REGION=
RAG_STORAGE_ENDPOINT=
RAG_STORAGE_ACCESS_KEY=
RAG_STORAGE_SECRET_KEY=

# =============================================================================
# RCRT (local context-sync layer)
# =============================================================================

RCRT_BASE_URL=
RCRT_JWT_SECRET=
# Used by services/rcrtClient.ts as the registry's own public URL when
# provisioning RCRT clients. Default: https://tso.onrender.com
REGISTRY_URL=https://tso.onrender.com
FRONTEND_URL=https://taisplatform.vercel.app

# =============================================================================
# CRON
# =============================================================================

# REQUIRED in production -- the app throws at startup if unset
# (config/index.ts). /admin/cron/* refuses to serve without it regardless,
# but a missing var should fail loudly at deploy time, not silently later.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# =============================================================================
# MONITORING & ALERTING (all optional -- everything degrades gracefully
# without these, but silently: no error tracking or alerts, not a visible
# failure. See MONITORING.md.)
# =============================================================================

SENTRY_DSN=
SENDGRID_API_KEY=
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
# MONITORING.md documents REDIS_URL (Upstash) for NFT-verification
# caching with an automatic in-memory fallback. It is NOT included here
# as a real var: `grep -rn REDIS packages/registry/src` finds zero
# references anywhere in current source, despite `ioredis` being a listed
# dependency -- the doc appears to describe a caching layer that either
# was removed or was never actually wired to an env var. Don't assume
# setting REDIS_URL does anything until this is confirmed against source
# (Sprint 3, item O3) -- re-grep before relying on MONITORING.md here.
