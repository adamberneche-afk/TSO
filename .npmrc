# typescript-eslint@8's peerDependency on typescript (">=4.8.4 <6.1.0")
# conflicts with the real typescript@7 this repo now runs -- a peer
# conflict that's actually fine in practice: postinstall (see
# scripts/link-typescript-eslint-compiler.js) gives typescript-eslint its
# own nested, TS7-compatible compiler copy. Without this, `npm install`
# refuses to resolve the tree at all before that script ever runs.
legacy-peer-deps=true
